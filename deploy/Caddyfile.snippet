# Add this to /srv/caddy/Caddyfile on the server.
# The game answers on two addresses with the same files and the same API:
#   e1-kart.ensite.org  the official one (links, share card, link preview)
#   e1kart.rrriooo.com  debug, for testing where ensite.org is blocked; not indexed by search engines

(e1kart) {
	encode zstd gzip

	# API: Spring Boot inside the e1kart-api container, on Caddy's same "web" Docker network.
	handle /api/* {
		request_body {
			max_size 9MB
		}
		reverse_proxy e1kart-api:8080
	}

	# Game: static files built by Vite.
	handle {
		root * /srv/e1-kart-gp

		# Service worker, manifest and index always fresh, so updates arrive right away.
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache"

		# Files in /assets have the hash in their name: long cache.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		file_server
	}
}

e1-kart.ensite.org {
	import e1kart
}

e1kart.rrriooo.com {
	header X-Robots-Tag "noindex, nofollow"
	import e1kart
}
