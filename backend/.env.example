# Copy this file to /opt/e1kart-api/.env on the server.
# Generate the secret with: openssl rand -base64 48
# Don't change it after launch: a new secret would make already-used certificates valid again.
E1KART_ID_SECRET=

# true = the menu shows the "Play without a certificate" flag; false = can only play with runs.
E1KART_FREE_PLAY=true

# Token of the private stats page https://<game>/stats.html (generate with: openssl rand -hex 24). Empty = page off.
E1KART_STATS_TOKEN=
# E1 team standings: count only Interstellar races from this Korean date (yyyy-MM-dd); empty = all races
E1KART_STANDINGS_SINCE=
